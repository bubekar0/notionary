#!/bin/bash
# Stop the background dev server started by bin/serve. (Foreground runs stop with Ctrl-C.)
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PIDFILE="$ROOT/.serve.pid"

if [ ! -f "$PIDFILE" ]; then
   echo "Not running (no .serve.pid)."
   exit 0
fi

PID="$(cat "$PIDFILE")"
if kill "$PID" 2>/dev/null; then
   echo "Stopped notionary dev server (PID $PID)."
else
   echo "No live process for PID $PID -- removing stale pidfile."
fi
rm -f "$PIDFILE"
